eval "$(starship init zsh)"

export XDG_CONFIG_HOME="$HOME/.config"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_SHARE_HOME="$HOME/.local/share"
export STARSHIP_CONFIG="$XDG_CONFIG_HOME/starship.toml"
export EZA_CONFIG_DIR="$XDG_CONFIG_HOME/eza"
export NBRC_PATH="$HOME/.config/nb/.nbrc"
export NIX_USER_CONF_FILES="$XDG_CONFIG_HOME/nix/nix.conf:${XDG_CONFIG_HOME}/nix/local.conf"
export LESSHISTFILE="$XDG_STATE_HOME/less/history"
export ANDROID_USER_HOME="$XDG_SHARE_HOME/android"
export ANDROID_AVD_HOME="$ANDROID_USER_HOME/avd"
export GRADLE_USER_HOME="$XDG_SHARE_HOME/gradle"
export BUN_INSTALL="$XDG_SHARE_HOME/bun"
export PATH="$BUN_INSTALL/bin:$PATH"
export npm_config_cache="$HOME/.cache/npm"
